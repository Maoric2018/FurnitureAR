# Optional override. Default is the same-origin /api/products/import route.
# Public VITE_ values must never contain credentials.
VITE_PRODUCT_API_URL=
# Optional keyword-search endpoint override. Default: /api/products/search.
VITE_PRODUCT_SEARCH_API_URL=
# Keep SERPAPI_API_KEY in .dev.vars locally or in the deployed worker secret.
