# Leave empty to keep the explicit sample/demo flow.
# Must be an HTTPS endpoint (or same-origin relative route) accepting POST { url }.
# Vite exposes VITE_ values publicly: never put API secrets here.
VITE_PRODUCT_API_URL=

# For the included local Amazon bridge, set VITE_PRODUCT_API_URL=/api/products/import.
# Run the separate Amazon furniture API first. These values stay on the Vite server.
# FURNITURE_API_BASE_URL=http://127.0.0.1:8787
# FURNITURE_API_AUTH_TOKEN=
# Keep SERPAPI_API_KEY in the separate backend's .env, never in this app.
